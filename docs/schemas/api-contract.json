{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dylanportmann.github.io/EventVS-Portal/schemas/api-contract.json",
  "title": "Event VS Portal API request",
  "oneOf": [
    { "$ref": "#/$defs/startSession" },
    { "$ref": "#/$defs/verifySession" },
    { "$ref": "#/$defs/listRequests" },
    { "$ref": "#/$defs/getRequest" },
    { "$ref": "#/$defs/updateRequest" },
    { "$ref": "#/$defs/cancelEvent" },
    { "$ref": "#/$defs/getCancellationStatus" }
  ],
  "$defs": {
    "startSession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "email"],
      "properties": {
        "action": { "const": "startSession" },
        "email": { "type": "string", "format": "email", "maxLength": 320 },
        "challengeId": { "$ref": "#/$defs/challengeId" },
        "clientRequestId": { "$ref": "#/$defs/clientRequestId" }
      }
    },
    "verifySession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "email", "code"],
      "properties": {
        "action": { "const": "verifySession" },
        "email": { "type": "string", "format": "email", "maxLength": 320 },
        "code": { "type": "string", "pattern": "^[0-9]{6}$" },
        "challengeId": { "$ref": "#/$defs/challengeId" },
        "clientRequestId": { "$ref": "#/$defs/clientRequestId" }
      }
    },
    "listRequests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "payload", "sessionToken"],
      "properties": {
        "action": { "const": "listRequests" },
        "clientRequestId": { "$ref": "#/$defs/clientRequestId" },
        "sessionToken": { "$ref": "#/$defs/sessionToken" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "page": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "pageSize": { "type": "integer", "minimum": 1, "maximum": 100 },
            "filters": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "search": { "type": "string", "maxLength": 200 },
                "status": { "$ref": "#/$defs/globalStatus" },
                "dateFrom": { "type": "string", "format": "date" },
                "dateTo": { "type": "string", "format": "date" },
                "team": { "$ref": "#/$defs/team" },
                "late": { "type": ["boolean", "string"] }
              }
            }
          }
        }
      }
    },
    "getRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "requestId", "sessionToken"],
      "properties": {
        "action": { "const": "getRequest" },
        "clientRequestId": { "$ref": "#/$defs/clientRequestId" },
        "sessionToken": { "$ref": "#/$defs/sessionToken" },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "updateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "requestId", "expectedRevision", "changes", "sessionToken"],
      "properties": {
        "action": { "const": "updateRequest" },
        "clientRequestId": { "$ref": "#/$defs/clientRequestId" },
        "sessionToken": { "$ref": "#/$defs/sessionToken" },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "expectedRevision": { "type": "integer", "minimum": 1 },
        "changes": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 30,
          "propertyNames": {
            "enum": [
              "title", "labAcronym", "dateStart", "dateEnd", "startTime", "endTime",
              "fields.type", "fields.participants", "fields.publicTarget", "fields.access",
              "fields.safety", "fields.rooms", "fields.cateringSpaces", "fields.catering",
              "fields.furniture", "fields.partitions", "fields.screens", "fields.screenTitle",
              "fields.itNeeds", "fields.remarks"
            ]
          }
        },
        "reason": { "type": "string", "maxLength": 2000 },
        "clientContext": {
          "type": "object",
          "description": "Display only. Backend derives authoritative actor from validated Entra token claims.",
          "properties": {
            "displayName": { "type": "string", "maxLength": 200 },
            "username": { "type": "string", "maxLength": 320 }
          }
        }
      }
    },
    "cancelEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "requestId", "expectedRevision", "confirmation", "sessionToken"],
      "properties": {
        "action": { "const": "cancelEvent" },
        "clientRequestId": { "$ref": "#/$defs/clientRequestId" },
        "sessionToken": { "$ref": "#/$defs/sessionToken" },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "expectedRevision": { "type": "integer", "minimum": 1 },
        "confirmation": { "const": true },
        "reason": { "type": "string", "maxLength": 2000 }
      }
    },
    "getCancellationStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "requestId", "sessionToken"],
      "properties": {
        "action": { "const": "getCancellationStatus" },
        "clientRequestId": { "$ref": "#/$defs/clientRequestId" },
        "sessionToken": { "$ref": "#/$defs/sessionToken" },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "approvalTask": {
      "type": "object",
      "required": ["team", "revision", "status", "deliveryStatus"],
      "properties": {
        "team": { "$ref": "#/$defs/team" },
        "taskKey": { "type": "string", "pattern": "^$|^[^|]+\\|[^|]+\\|[0-9]+$" },
        "scopeHash": { "type": "string", "maxLength": 64 },
        "revision": { "type": "integer", "minimum": 1 },
        "origin": { "enum": ["Initial", "Revision"] },
        "status": { "enum": ["À venir", "Non requis", "En attente", "Approuvé", "Refusé", "Obsolète", "Suivi partiel"] },
        "deliveryStatus": { "enum": ["upcoming", "partial", "queued", "creating", "delivered", "responded", "response_received", "canceled", "cancel_failed", "create_failed", "obsolete", "response_conflict", "not_required"] },
        "assignee": { "type": "string" },
        "approvalId": { "type": "string" },
        "requestedAt": { "type": ["string", "null"], "format": "date-time" },
        "deliveredAt": { "type": ["string", "null"], "format": "date-time" },
        "respondedAt": { "type": ["string", "null"], "format": "date-time" },
        "response": { "type": "string" },
        "comment": { "type": "string" },
        "responder": { "type": "string" },
        "routingComplete": { "type": "boolean" },
        "replacesTaskKey": { "type": "string" },
        "supersededBy": { "type": "string" }
      }
    },
    "sync": {
      "type": "object",
      "required": ["checkedAt", "status"],
      "properties": {
        "checkedAt": { "type": "string", "format": "date-time" },
        "status": { "enum": ["ok", "partial", "error"] },
        "warning": { "type": "string" }
      }
    },
    "approvalChanges": {
      "type": "object",
      "required": ["created", "canceled", "kept", "errors"],
      "properties": {
        "created": { "type": "array", "items": { "$ref": "#/$defs/approvalTask" } },
        "canceled": { "type": "array", "items": { "type": "object", "required": ["team", "taskKey"], "properties": { "team": { "$ref": "#/$defs/team" }, "taskKey": { "type": "string" }, "deliveryStatus": { "type": "string" } } } },
        "kept": { "type": "array", "items": { "type": "object", "required": ["team"], "properties": { "team": { "$ref": "#/$defs/team" }, "status": { "type": "string" }, "taskKey": { "type": "string" } } } },
        "errors": { "type": "array", "items": { "type": "object", "required": ["team", "code"], "properties": { "team": { "$ref": "#/$defs/team" }, "code": { "enum": ["cancel_failed", "create_failed", "response_conflict"] } } } }
      }
    },
    "sessionToken": { "type": "string", "minLength": 72, "maxLength": 72 },
    "challengeId": { "type": "string", "format": "uuid" },
    "clientRequestId": { "type": "string", "format": "uuid" },
    "team": { "enum": ["", "Event", "Infra", "Sécurité", "Signalétique", "IT"] },
    "globalStatus": {
      "enum": ["", "Reçu", "Validation Event en cours", "Étude technique", "Modification en cours", "Annulation en cours", "Suppression bloquée", "Validé", "Refusé", "Suivi partiel", "Capacité dépassée", "Ressource indisponible"]
    }
  }
}
